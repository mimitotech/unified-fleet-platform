# =============================================================================
# MAMS production — Hostinger → Environment variables → Import .env
# Permanent domain: https://mams.mimitotracking.com
# Permanent MySQL:  u632889724_mams
# Mail from:        mams@mimitotracking.com (smtp.hostinger.com:465 SSL)
#
# Prefer discrete DB_* / SMTP_* vars. Do not set DATABASE_URL unless you
# URL-encode @ in the password as %40.
# =============================================================================

NODE_ENV=production
PORT=3000

# --- MySQL (Hostinger hPanel → Databases) ---
DB_USER=u632889724_mams
DB_PASSWORD=CHANGE_ME_HPANEL_DATABASE_PASSWORD
DB_NAME=u632889724_mams
# Optional overrides (leave unset on Hostinger unless debugging):
# DB_HOST=127.0.0.1
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# DB_PORT=3306
DB_CONNECTION_LIMIT=8
DB_QUEUE_LIMIT=80

# --- Public URLs (same origin: SPA + API on one domain) ---
API_PUBLIC_URL=https://mams.mimitotracking.com
FRONTEND_URL=https://mams.mimitotracking.com
VITE_APP_URL=https://mams.mimitotracking.com
# Empty = browser calls /api on the same host (required for production)
VITE_API_URL=

# --- Secrets (generate once; do not rotate ENCRYPTION_KEY after go-live) ---
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_HEX_OR_BASE64
# openssl rand -base64 48
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_KEY_VALUE!!

# --- Outbound email (Hostinger mailbox) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=mams@mimitotracking.com
SMTP_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
SMTP_FROM_EMAIL=mams@mimitotracking.com
SMTP_FROM_NAME=MAMS
# auto = nodemailer (Hostinger Node) with PHPMailer fallback when PHP CLI exists
MAIL_TRANSPORT=nodemailer
# Optional: path to PHP CLI on Hostinger (default: php)
# PHP_BIN=/usr/bin/php
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# --- Runtime paths ---
UPLOAD_DIR=uploads
FRONTEND_DIST=frontend/dist
REDIS_DISABLED=1
DRIVER_LICENSE_ALERT_DAYS=30,14,7
DRIVER_LICENSE_EXPIRED_ACTION=warn

# --- Telematics provider bases (tokens live per-tenant in DB) ---
WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html
LOCONAV_API_URL=https://api.a.loconav.com
TRACKSOLID_API_URL=https://api.tracksolid.com
LOCONAV_WEBHOOK_SECRET=
TRACKSOLID_WEBHOOK_SECRET=
