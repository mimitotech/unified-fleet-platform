# =============================================================================
# Hostinger → Environment variables → Import .env
# App connects via Unix socket first, then TCP 127.0.0.1 (avoids ::1)
# =============================================================================

NODE_ENV=production
PORT=3000

DB_USER=u454222977_mams
DB_PASSWORD=CHANGE_ME
DB_NAME=u454222977_mams
# Optional:
# DB_HOST=127.0.0.1
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# DB_PORT=3306

# Prefer DB_* only. If you keep DATABASE_URL, URL-encode @ in password as %40:
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DB_NAME

API_PUBLIC_URL=https://mams.frontstardigital.com
FRONTEND_URL=https://mams.frontstardigital.com
VITE_API_URL=

JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_KEY!!

UPLOAD_DIR=uploads
FRONTEND_DIST=frontend/dist
REDIS_DISABLED=1

WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html
