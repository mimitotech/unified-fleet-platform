{
  "name": "unified-fleet-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant fleet platform unifying Wialon, LocoNav, and TrackSolid",
  "main": "hostinger-start.mjs",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "node scripts/hostinger-build.mjs",
    "build:local": "npm run build -w @ufp/shared && npm run build -w frontend && npm run build -w backend",
    "build:hostinger": "node scripts/hostinger-build.mjs",
    "start": "node hostinger-start.mjs",
    "start:local": "node backend/dist/index.js",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "db:migrate": "bash scripts/seed-db.sh",
    "db:ensure-users": "node --import tsx scripts/ensure-login-users.mts",
    "setup": "bash scripts/setup.sh",
    "verify:fuel": "node --import tsx scripts/verify-fuel-structure.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
