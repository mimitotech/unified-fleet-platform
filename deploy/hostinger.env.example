# =============================================================================
# Copy these into Hostinger → Website → Environment variables
# Also save locally as .env (never commit real secrets)
# =============================================================================

NODE_ENV=production
PORT=3000

# MySQL (Hostinger hPanel → Databases — verify HOST if not localhost)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u454222977_mams
DB_PASSWORD=CHANGE_ME_ROTATE_AFTER_CHAT
DB_NAME=u454222977_mams

# Optional single URL form (overrides discrete DB_* if set):
# DATABASE_URL=mysql://u454222977_mams:PASSWORD@localhost:3306/u454222977_mams

# Public URLs (same Hostinger Node app serves API + PWA)
API_PUBLIC_URL=https://mams.frontstardigital.com
FRONTEND_URL=https://mams.frontstardigital.com

# Same-origin API for the PWA build (leave empty so browser calls /api on same host)
VITE_API_URL=

# Required secrets — generate long random strings
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_KEY!!

# Uploads on the Node app filesystem
UPLOAD_DIR=uploads
FRONTEND_DIST=frontend/dist

# Redis not available on typical Hostinger Node — keep disabled
REDIS_DISABLED=1

# Optional maps
# VITE_GOOGLE_MAPS_KEY=
# VITE_MAPTILER_KEY=

# Telematics defaults (per-tenant credentials live encrypted in MySQL)
WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html
LOCONAV_API_URL=https://api.a.loconav.com
TRACKSOLID_API_URL=https://api.tracksolid.com
LOCONAV_WEBHOOK_SECRET=
TRACKSOLID_WEBHOOK_SECRET=
