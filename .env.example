# Database
DATABASE_URL=postgresql://ufp:ufp_dev@localhost:5432/unified_fleet
REDIS_URL=redis://localhost:6379

# API
PORT=3000
JWT_SECRET=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=dev-encryption-key-32chars!!!!!!

# Public URL for webhook links shown in Admin (use your production domain)
API_PUBLIC_URL=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:3000
# Google Maps (Wialon-provided key) — official basemap for fleet maps
VITE_GOOGLE_MAPS_KEY=
# Optional — MapTiler Streets (fast CDN + full road/building detail). Free tier: https://maptiler.com
VITE_MAPTILER_KEY=

# Telematics API defaults (per-tenant credentials are stored encrypted in DB)
WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html
# LocoNav: use api.a.loconav.com or api.loconav.com depending on your account region
LOCONAV_API_URL=https://api.a.loconav.com
TRACKSOLID_API_URL=https://api.tracksolid.com

# Webhook HMAC secrets — must match values configured in LocoNav / TrackSolid portals
LOCONAV_WEBHOOK_SECRET=
TRACKSOLID_WEBHOOK_SECRET=
